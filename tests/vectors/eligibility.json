{
  "version": "1.0",
  "description": "Shared cross-language eligibility test vectors verified by both pytest (backend) and vitest (frontend legacy fallback + pass-through).",
  "vectors": [
    {
      "id": "plus_n_more_hubs_teamtailor",
      "description": "Teamtailor (+N more) truncated hubs with full all_locations list",
      "extraction_input": {
        "provider": "teamtailor",
        "work_model": "hybrid",
        "location": "Accra, Ghana; Cape Town, South Africa; Dubai, UAE (+2 more)",
        "raw_location": "Accra, Ghana, Cape Town, South Africa, Dubai, UAE, Lagos, Nigeria, Nairobi, Kenya",
        "description": "Senior DevOps Engineer working from our regional offices.",
        "raw_fields": {
          "all_locations": [
            "Accra, Ghana",
            "Cape Town, South Africa",
            "Dubai, UAE",
            "Lagos, Nigeria",
            "Nairobi, Kenya"
          ]
        },
        "expected_classification": "country_restricted",
        "expected_global_remote_explicit": false,
        "expected_allowed_country_codes_superset": ["GH", "ZA", "AE", "NG", "KE"]
      },
      "work_model": "hybrid",
      "location": "Accra, Ghana; Cape Town, South Africa; Dubai, UAE (+2 more)",
      "eligibility": {
        "classification": "country_restricted",
        "work_arrangement": "hybrid",
        "allowed_country_codes": ["GH", "ZA", "AE", "NG", "KE"],
        "allowed_residence_countries": ["Ghana", "South Africa", "UAE", "Nigeria", "Kenya"],
        "residence_restriction_confirmed": true,
        "global_remote_explicit": false
      },
      "expected_objective_scope_label": "Ghana, South Africa, United Arab Emirates, Nigeria, and Kenya",
      "expected_assessments": {
        "NG": { "status": "eligible", "summary_contains": "Hybrid · Accra, Ghana" },
        "KE": { "status": "eligible", "summary_contains": "Hybrid · Accra, Ghana" },
        "GH": { "status": "eligible", "summary_contains": "Hybrid · Accra, Ghana" },
        "ZA": { "status": "eligible", "summary_contains": "Hybrid · Accra, Ghana" },
        "US": { "status": "restricted", "summary_contains": "Ghana" }
      }
    },
    {
      "id": "workable_pipe_hubs",
      "description": "Workable pipe-separated multi-office hubs",
      "extraction_input": {
        "provider": "workable",
        "work_model": "hybrid",
        "location": "İstanbul, Turkey | Lagos, Nigeria",
        "description": "Build lending services with our Istanbul and Lagos engineering teams.",
        "raw_fields": {
          "location": { "city": "İstanbul", "country": "Turkey", "countryCode": "TR" },
          "locations": [
            { "city": "İstanbul", "country": "Turkey", "countryCode": "TR" },
            { "city": "Lagos", "country": "Nigeria", "countryCode": "NG" }
          ]
        },
        "expected_classification": "country_restricted",
        "expected_global_remote_explicit": false,
        "expected_allowed_country_codes_superset": ["TR", "NG"]
      },
      "work_model": "hybrid",
      "location": "İstanbul, Turkey | Lagos, Nigeria",
      "eligibility": {
        "classification": "country_restricted",
        "work_arrangement": "hybrid",
        "allowed_country_codes": ["TR", "NG"],
        "allowed_residence_countries": ["Turkey", "Nigeria"],
        "residence_restriction_confirmed": true,
        "global_remote_explicit": false
      },
      "expected_objective_scope_label": "Turkey and Nigeria",
      "expected_assessments": {
        "NG": { "status": "eligible", "summary_contains": "Hybrid · İstanbul, Turkey | Lagos, Nigeria" },
        "TR": { "status": "eligible", "summary_contains": "Hybrid · İstanbul, Turkey | Lagos, Nigeria" },
        "US": { "status": "restricted" }
      }
    },
    {
      "id": "ashby_secondary_locations_multicountry",
      "description": "Ashby multi-country remote secondaryLocations sets explicit country restrictions",
      "extraction_input": {
        "provider": "ashby",
        "work_model": "remote",
        "location": "United Kingdom; South Africa; Canada; Brazil",
        "description": "Collaborate across distributed teams globally.",
        "raw_fields": {
          "location": "United Kingdom",
          "workplaceType": "Remote",
          "secondaryLocations": [
            { "location": "South Africa" },
            { "location": "Canada" },
            { "location": "Brazil" }
          ]
        },
        "expected_classification": "country_restricted",
        "expected_global_remote_explicit": false,
        "expected_allowed_country_codes_exact": ["GB", "ZA", "CA", "BR"]
      },
      "work_model": "remote",
      "location": "United Kingdom; South Africa; Canada; Brazil",
      "eligibility": {
        "classification": "country_restricted",
        "work_arrangement": "remote",
        "allowed_country_codes": ["GB", "ZA", "CA", "BR"],
        "allowed_residence_countries": ["United Kingdom", "South Africa", "Canada", "Brazil"],
        "residence_restriction_confirmed": true,
        "global_remote_explicit": false
      },
      "expected_objective_scope_label": "UK, South Africa, Canada, and Brazil",
      "expected_assessments": {
        "GB": { "status": "eligible", "summary_contains": "United Kingdom eligible" },
        "ZA": { "status": "eligible", "summary_contains": "South Africa eligible" },
        "CA": { "status": "eligible", "summary_contains": "Canada eligible" },
        "NG": { "status": "restricted", "summary_contains": "Remote" },
        "US": { "status": "restricted" }
      }
    },
