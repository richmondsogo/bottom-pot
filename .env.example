# Bottom Pot Environment Configuration Example
# Copy this file to .env and provide your actual API keys.

# Serper API key for Google search discovery (Required for live mode: https://serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# Search behaviour
MAX_RESULTS=300
MONITORED_STORE_MAX_RESULTS=200
NIGERIAN_PER_SCRAPER_CAP=30
NIGERIAN_TOTAL_CAP=75
MAX_SERPER_QUERIES_PER_SEARCH=60
SERPER_MAX_PAGES=5
# Title-first search relevance filter: "filter" (default) or "off" (disable filtering without redeploy)
RELEVANCE_MODE=filter

# Timeouts (in seconds)
ATS_REQUEST_TIMEOUT_SECONDS=5
SCRAPER_REQUEST_TIMEOUT_SECONDS=10
SEARCH_HARD_TIMEOUT_SECONDS=90

# Politeness delay for custom scrapers (in seconds)
SCRAPER_DELAY_SECONDS=1.5

# In-memory LRU cache
CACHE_TTL_SECONDS=300
IN_MEMORY_CACHE_MAX_ENTRIES=100

# Serper cost & replay controls
SERPER_DAILY_BUDGET=500
# Serper mode: "fallback" (monitored store first, Serper only below threshold), "live", or "cache_only"
SERPER_MODE=fallback
SERPER_FALLBACK_MIN_RESULTS=25
SERPER_CACHE_TTL_HOURS=12
URL_CACHE_TTL_HOURS=24

# Persistent cloud Postgres (Neon) — leave unset locally to use SQLite in BOTTOM_POT_DATA_DIR
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Background ATS board monitor
MONITORING_ENABLED=true
# Data storage directory outside the repository tree for new local/container installs
# (Windows default: %LOCALAPPDATA%\bottom-pot, macOS: ~/Library/Application Support/bottom-pot, Linux: ~/.local/share/bottom-pot).
# Existing installs with data/cache.sqlite continue working unchanged until migrated (see docs/operations/RUNBOOK.md).
# BOTTOM_POT_DATA_DIR=
# Optional explicit path overrides (uncomment only for non-standard layouts):
# SQLITE_DB_PATH=data/cache.sqlite

# Concurrency & Resilience
GLOBAL_CONCURRENCY_LIMIT=20
PER_HOST_CONCURRENCY_LIMIT=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=600
# Max response stream size in bytes (3 MB = 3145728)
MAX_RESPONSE_BYTES=3145728

# Rate limiting & Proxy / CORS
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_SEARCH=20/hour
RATE_LIMIT_SUBSCRIBE=10/hour
RATE_LIMIT_ELIGIBILITY=60/minute
RATE_LIMIT_ADMIN_LOGIN=5/minute
# Set true when deployed behind Vercel / Railway / Render / Fly reverse proxy so per-user rate limits read X-Forwarded-For
TRUST_PROXY_HEADERS=false
# Comma-separated browser origins permitted by CORS (set your Vercel URL in production)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Admin & Vercel Cron authentication
ADMIN_PASSWORD=
# Session signing secret (leave blank in dev to auto-generate; REQUIRED in production / serverless deployments)
ADMIN_SESSION_SECRET=
# Set to "none" only for cross-origin HTTPS frontend + separate API domain admin cookies
ADMIN_COOKIE_SAMESITE=lax
# Bearer secret authorizing scheduled GET/POST /api/cron/monitor board refreshes
CRON_SECRET=

# Subscriptions file override (defaults to <BOTTOM_POT_DATA_DIR>/subscriptions.csv or ./subscriptions.csv for legacy installs)
# SUBSCRIPTIONS_FILE=subscriptions.csv

# Logo.dev frontend publishable token (optional; ONLY pk_ publishable keys may be placed here, NEVER sk_ secret keys)
# VITE_LOGO_DEV_TOKEN=pk_your_publishable_token_here

# Optional public URL or mailto: for the "Report a problem with this listing" link (defaults to mailto: contact email; must start with https:// or mailto:)
# VITE_REPORT_PROBLEM_URL=mailto:richmondsogo@gmail.com

# Logging
LOG_LEVEL=INFO
