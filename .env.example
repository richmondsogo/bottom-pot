# Bottom Pot Environment Configuration Example
# Copy this file to .env and provide your actual API keys.

# Serper API key for Google search discovery (Required for live mode: https://serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# Search behaviour
MAX_RESULTS=100
MAX_SERPER_QUERIES_PER_SEARCH=60
SERPER_MAX_PAGES=3

# Timeouts (in seconds)
ATS_REQUEST_TIMEOUT_SECONDS=5
SCRAPER_REQUEST_TIMEOUT_SECONDS=10
SEARCH_HARD_TIMEOUT_SECONDS=90

# Politeness delay for custom scrapers (in seconds)
SCRAPER_DELAY_SECONDS=1.5

# In-memory LRU cache
CACHE_TTL_SECONDS=300
IN_MEMORY_CACHE_MAX_ENTRIES=100

# Serper cost & replay controls
SERPER_DAILY_BUDGET=200
# Serper mode: "live" or "cache_only"
SERPER_MODE=live
SERPER_CACHE_TTL_HOURS=12
URL_CACHE_TTL_HOURS=24
SQLITE_DB_PATH=data/cache.sqlite

# Concurrency & Resilience
GLOBAL_CONCURRENCY_LIMIT=20
PER_HOST_CONCURRENCY_LIMIT=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=600
# Max response stream size in bytes (3 MB = 3145728)
MAX_RESPONSE_BYTES=3145728

# Rate limiting
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_SEARCH=20/hour

# Subscriptions file path
SUBSCRIPTIONS_FILE=subscriptions.csv

# Logging
LOG_LEVEL=INFO
