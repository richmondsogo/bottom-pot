# Optional backend API base URL for split Vercel + container deployments (e.g. https://api.bottompot.example)
# Leave blank for same-origin local server / Vite dev proxy.
# VITE_API_BASE_URL=

# Optional Logo.dev publishable client token for fallback company logos (pk_* only; NEVER sk_* secret keys).
# Restrict allowed origins to your production domain in the Logo.dev dashboard before deploying.
# VITE_LOGO_DEV_TOKEN=pk_your_publishable_token_here

# Optional https:// or mailto: endpoint for "Report a problem with this listing" links in job details (defaults to mailto: contact email; no PII sent).
# VITE_REPORT_PROBLEM_URL=mailto:richmondsogo@gmail.com

# Optional override for the public contact email shown on /contact, /privacy, /terms, and in the footer (defaults to richmondsogo@gmail.com).
# VITE_CONTACT_EMAIL=richmondsogo@gmail.com

# Optional canonical production site origin used at build time for canonical links, OG/Twitter URLs, robots.txt, and sitemap.xml.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL or https://bottom-pot-puce.vercel.app when unset.
# VITE_SITE_URL=https://bottom-pot-puce.vercel.app
